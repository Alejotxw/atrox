# =============================================================================
# Atrox Backend — Variables de entorno
# =============================================================================
# 1) Copia este archivo a .env (NO subas .env al repositorio):
#      copy .env.example .env
# 2) Ajusta los valores según tu máquina / entorno.
# =============================================================================

ATROX_APP_NAME=Atrox API
ATROX_HOST=0.0.0.0
ATROX_PORT=8000
ATROX_ENV=development
ATROX_DEBUG=true
ATROX_NMAP_PATH=nmap
ATROX_NMAP_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Nuclei (escaneo de vulnerabilidades)
# -----------------------------------------------------------------------------
# Timeout del job completo (segundos). Targets remotos lentos (p. ej. Heroku)
# suelen necesitar más de 480s si no se limitan plantillas.
ATROX_NUCLEI_TIMEOUT_SECONDS=720
# ATROX_NUCLEI_DOCKER_IMAGE=projectdiscovery/nuclei:latest
# ATROX_NUCLEI_DOCKER_TEMPLATES_VOLUME=atrox-nuclei-templates
ATROX_NUCLEI_CONCURRENCY=50
ATROX_NUCLEI_RATE_LIMIT=150
ATROX_NUCLEI_REQUEST_TIMEOUT=5
ATROX_NUCLEI_RETRIES=0
ATROX_NUCLEI_MAX_HOST_ERROR=8
# ATROX_NUCLEI_EXCLUDE_TAGS=["dos","fuzz","intrusive"]
# ATROX_NUCLEI_DEFAULT_PROTOCOLS=["http"]
ATROX_NUCLEI_ACCEPT_PARTIAL_ON_TIMEOUT=true

# -----------------------------------------------------------------------------
# HU-007 — Cifrado AES-256-GCM (OBLIGATORIO para hallazgos/credenciales/reportes)
# -----------------------------------------------------------------------------
# Sin esta llave, los endpoints /api/findings, /api/credentials y /api/reports
# responderán 503, y los jobs no persistirán hallazgos cifrados.
#
# Cómo generar la llave (PowerShell, desde src/Backend):
#
#   cd C:\Users\Usuario\atrox\src\Backend
#   .\.venv\Scripts\Activate.ps1
#   python -c "from atrox.security.encryption import generate_master_key; print(generate_master_key())"
#
# Luego descomenta la línea de abajo y pega el valor generado:
# ATROX_ENCRYPTION_MASTER_KEY=pega_aqui_la_llave_generada
#
# IMPORTANTE:
# - NUNCA subas la llave real a GitHub / commits.
# - Cada compañero puede generar su propia llave local para desarrollo.
# - Si cambias la llave, no podrás descifrar datos guardados con la anterior.
# -----------------------------------------------------------------------------
# ATROX_ENCRYPTION_MASTER_KEY=
ATROX_ENCRYPTED_STORAGE_PATH=data/encrypted

# -----------------------------------------------------------------------------
# HU-008 — Log de auditoría inmutable (HMAC)
# -----------------------------------------------------------------------------
# Cómo generar la llave de firma:
#
#   python -c "from atrox.security.audit_signer import generate_signing_key; print(generate_signing_key())"
#
# Luego descomenta y pega:
# ATROX_AUDIT_SIGNING_KEY=pega_aqui_la_llave_generada
# -----------------------------------------------------------------------------
# ATROX_AUDIT_SIGNING_KEY=
ATROX_AUDIT_LOG_PATH=data/audit.log
ATROX_AUDIT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# HU-012 — Abstracción de proveedores LLM (Gemini Cloud / Ollama local)
# -----------------------------------------------------------------------------
# Selecciona el motor primario: "gemini" (Cloud) | "ollama" (local) | "mock".
# "mock" es el default y NO hace llamadas de red (desarrollo/tests).
#
#   ATROX_LLM_PROVIDER=gemini
#   ATROX_LLM_API_KEY=pega_aqui_tu_clave_de_gemini
#
# Fallback: si el primario no responde (red caída, HTTP error, clave inválida),
# se prueba la lista JSON en orden. Ejemplo: gemini caído -> intenta Ollama.
#   ATROX_LLM_FALLBACK_PROVIDERS=["ollama"]
#
# ATROX_LLM_PROVIDER=mock
# ATROX_LLM_MODEL=
# ATROX_LLM_API_KEY=
# Timeout de lectura HTTP hacia el LLM (segundos). Modelos locales suelen
# necesitar 120–180s; un valor bajo corta la auditoría con error de red.
ATROX_LLM_TIMEOUT_SECONDS=180
ATROX_LLM_GEMINI_MODEL=gemini-2.0-flash
ATROX_LLM_OLLAMA_BASE_URL=http://localhost:11434
ATROX_LLM_OLLAMA_MODEL=llama3
# Límites de generación Ollama (menos tokens = respuesta más rápida):
ATROX_LLM_OLLAMA_NUM_PREDICT=640
ATROX_LLM_OLLAMA_NUM_CTX=4096
ATROX_LLM_OLLAMA_KEEP_ALIVE=10m
# ATROX_LLM_FALLBACK_PROVIDERS=["ollama"]

# -----------------------------------------------------------------------------
# HU-005 — Sincronización diaria de base de amenazas (NVD / RF-010)
# -----------------------------------------------------------------------------
# ATROX_NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# ATROX_NVD_API_KEY=  # Opcional, recomendado por NVD para evitar rate limits
ATROX_NVD_REQUEST_TIMEOUT_SECONDS=30
ATROX_NVD_SYNC_INTERVAL_HOURS=24
# ATROX_NVD_SYNC_ENABLED=true
# ATROX_NVD_SYNC_ON_STARTUP=false
ATROX_NVD_STORE_PATH=data/threat_intel/cves.jsonl
ATROX_NVD_SYNC_STATUS_PATH=data/threat_intel/last_sync.json

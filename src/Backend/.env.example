# Copiar a .env y ajustar valores según el entorno
ATROX_APP_NAME=Atrox API
ATROX_HOST=0.0.0.0
ATROX_PORT=8000
ATROX_ENV=development
ATROX_DEBUG=true
ATROX_NMAP_PATH=nmap
ATROX_NMAP_TIMEOUT_SECONDS=300

# Cifrado en reposo (HU-007) — generar con: python -c "from atrox.security.encryption import generate_master_key; print(generate_master_key())"
# ATROX_ENCRYPTION_MASTER_KEY=

# Log de auditoría inmutable (HU-008) — generar con: python -c "from atrox.security.audit_signer import generate_signing_key; print(generate_signing_key())"
# ATROX_AUDIT_SIGNING_KEY=
ATROX_AUDIT_LOG_PATH=data/audit.log
ATROX_AUDIT_RETENTION_DAYS=365
